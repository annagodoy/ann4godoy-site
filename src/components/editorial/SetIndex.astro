---
import type { CollectionEntry } from "astro:content";
import SetItem from "./SetItem.astro";

interface Props {
  sets: readonly CollectionEntry<"sets">[];
}

const { sets } = Astro.props;

---

{
  sets.length > 0 ? (
    <ol class="set-index">
      {sets.map((set) => (
        <li class="set-index__item">
          <SetItem set={set} />
        </li>
      ))}
    </ol>
  ) : (
    <p class="set-index__empty">
      Nenhum set publicado no momento.
    </p>
  )
}

<style>
  .set-index {
    margin: 0;
    padding: 0;

    list-style: none;
  }

  .set-index__item:last-child {
    border-bottom: 1px solid var(--color-line);
  }

  .set-index__empty {
    color: var(--color-muted);
  }
</style>
