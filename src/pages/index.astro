---
import BaseLayout from '../layouts/BaseLayout.astro';
import Contents from '../components/editorial/Contents.astro';
import Cover from '../components/editorial/Cover.astro';
import SetIndex from "../components/editorial/SetIndex.astro";
import MaremotoIndex from '../components/editorial/MaremotoIndex.astro';
import DateInviteIndex from '../components/editorial/DateInviteIndex.astro';
import EditorialIntro from '../components/editorial/EditorialIntro.astro';
import ContactDetails from '../components/editorial/ContactDetails.astro';
import SetPlayer from '../components/player/SetPlayer';
import type { PlayerSet } from '../types/set-player';

import { getCollection } from 'astro:content';

const contents = [
  { id: "editorial", title: "Editorial" },
  { id: "sets", title: "Sets" },
  { id: "date-invites", title: "Te convido para um Date" },
  { id: "maremoto", title: "Maremoto" },
  { id: "contact", title: "Contato" },
];

const sets = (await getCollection("sets")).toSorted(
  (a, b) => b.data.publishedAt.valueOf() - a.data.publishedAt.valueOf(),
);

const maremotoSessions = (
  await getCollection("maremotoSessions")
).toSorted(
  (a, b) =>
    b.data.publishedAt.valueOf() - a.data.publishedAt.valueOf(),
);

const dateInvites = (
  await getCollection("dateInvites")
).toSorted(
  (a, b) =>
    b.data.publishedAt.valueOf() - a.data.publishedAt.valueOf(),
);

const playerSets: PlayerSet[] = sets.map(({ id, data }) => ({
  id,
  title: data.title,
  platform: data.platform,
  providerId: data.providerId,
  url: data.url,
}));

const maremotoPlayerSets: PlayerSet[] = maremotoSessions.map(
  ({ id, data }) => ({
    id,
    title: `Maremoto Sessions #${String(data.episode).padStart(2, "0")} — ${data.dj}`,
    platform: "soundcloud",
    providerId: data.providerId,
    url: data.url,
  }),
);

const dateInvitePlayerSets: PlayerSet[] = dateInvites.map(
  ({ id, data }) => ({
    id,
    title: `Te convido para um Date #${String(data.episode).padStart(2, "0")} — ${data.dj}`,
    platform: "soundcloud",
    providerId: data.providerId,
    url: data.url,
  }),
);

const editorialConcept = "Warm Graphite marca um período de construção, amadurecimento e apresentação de uma nova fase. Como uma superfície ainda aberta, esta primeira edição cria espaço para experimentar ideias, texturas musicais e referências contemporâneas. O grafite oferece a base; as cores surgem aos poucos, conforme cada pesquisa, encontro e seleção passa a ocupar esse território.";
---

<BaseLayout title="ANN4GODOY — Issue 001: Warm Graphite">
	<Cover
		artistName="ANN4GODOY"
		issueNumber="001"
		issueTitle="Warm Graphite"
		tagline="DJ, pesquisa musical e experiências editoriais."
	/>

  <Contents items={contents} />

  <main>
    <section
      id="editorial"
      class="editorial-section"
      aria-labelledby="editorial-title"
    >
      <h2 id="editorial-title">Editorial</h2>
      <EditorialIntro
        title="Uma superfície para novas ideias"
        concept={editorialConcept}
        pullQuote="O grafite oferece a base; as cores surgem aos poucos."
      >
        <p slot="release">
          Uma das fundadoras e idealizadoras do coletivo Maremoto (<a
            href="https://www.instagram.com/ma.re.moto/"
            target="_blank"
            rel="noopener noreferrer"
          >@ma.re.moto</a>), <strong>ANN4GODOY</strong> iniciou sua trajetória com sets inspirados
          em ritmos afro-diaspóricos. Sua pesquisa musical atravessa gêneros e estilos,
          explorando a pluralidade de sua ancestralidade. Suas apresentações celebram a
          diversidade sonora por meio de ritmos que expressam sua identidade.
        </p>
      </EditorialIntro>
    </section>

    <section id="sets" class="sets-section" aria-labelledby="sets-title">
      <h2 id="sets-title">Sets</h2>
      <p>Seleções musicais e sets.</p>

      <div class="sets-section__player">
        <SetPlayer sets={playerSets} heading="Player de sets" client:visible />
      </div>

      <SetIndex sets={sets} />
    </section>

    <section
      id="date-invites"
      class="date-invites"
      aria-labelledby="date-invites-title"
    >
      <h2 id="date-invites-title">Te convido para um Date</h2>
      <p>Arquivo de edições do programa trimestral na Funcion.fm.</p>

      <div class="date-invites__player">
        <SetPlayer
          sets={dateInvitePlayerSets}
          heading="Player Te convido para um Date"
          client:visible
        />
      </div>

      <DateInviteIndex invites={dateInvites} />
    </section>

    <section
      id="maremoto"
      class="maremoto-section"
      aria-labelledby="maremoto-title"
    >
      <h2 id="maremoto-title">Maremoto</h2>
      <p>Sonoridades Eletro-Periféricas.</p>

      <div class="maremoto-section__player">
        <SetPlayer
          sets={maremotoPlayerSets}
          heading="Player Maremoto"
          client:visible
        />
      </div>
      <MaremotoIndex sessions={maremotoSessions} />
    </section>

    <section
      id="contact"
      class="contact-section"
      aria-labelledby="contact-title"
    >
      <h2 id="contact-title">Vamos criar um encontro</h2>

      <p>Para bookings, colaborações e projetos, entre em contato.</p>

      <ContactDetails
        email="ann4godoy@gmail.com"
        instagramUrl="https://www.instagram.com/ann4godoy/"
        instagramHandle="@ann4godoy"
      />
    </section>
  </main>
</BaseLayout>

<style>
  section {
    display: grid;
    align-content: space-between;
    gap: var(--space-6);
    min-block-size: 65svh;
    padding: var(--section-spacing) var(--page-padding);
    border-bottom: 1px solid var(--color-line);
  }

  section h2 {
    font-family: var(--font-display);
    font-size: var(--text-heading-lg);
    font-weight: 400;
    line-height: 0.95;
    letter-spacing: -0.04em;
  }

  section > p {
    max-width: var(--content-max-width);
    color: var(--color-muted);
    line-height: 1.5;
  }

  section:target {
    box-shadow: inset 0.25rem 0 0 var(--color-ink);
  }

  /* Regras-base: mobile e todos os tamanhos */
  .sets-section {
    align-content: start;
  }

  .sets-section__player {
    margin-top: var(--space-6);
  }

  .sets-section :global(.set-index) {
    margin-top: var(--space-6);
  }

  .maremoto-section {
    align-content: start;
  }

  .maremoto-section__player {
    margin-top: var(--space-6);
  }

  .maremoto-section :global(.maremoto-index) {
    margin-top: var(--space-6);
  }

  .date-invites {
    align-content: start;
  }

  .date-invites__player {
    margin-top: var(--space-6);
  }

  .date-invites :global(.date-invite-index) {
    margin-top: var(--space-6);
  }

  .editorial-section {
    align-content: start;
  }

  .editorial-section :global(.editorial-intro) {
    margin-top: var(--space-6);
  }

  .contact-section {
    align-content: start;
  }

  .contact-section :global(.contact-details) {
    margin-top: var(--space-6);
  }

  /* Regras específicas para tablet/desktop: a partir de 768 px */
  @media (min-width: 48rem) {
    section {
      grid-template-columns: repeat(12, minmax(0, 1fr));
      align-content: end;
      column-gap: var(--grid-gap);
    }

    section h2 {
      grid-column: 1 / 8;
      grid-row: 1;

      align-self: end;
    }

    section > p {
      grid-column: 9 / -1;
      grid-row: 1;
      align-self: end;
    }

    .sets-section {
      align-content: start;
    }

    .sets-section h2 {
      grid-column: 1 / 8;
      grid-row: 1;
    }

    .sets-section > p {
      grid-column: 9 / -1;
      grid-row: 1;
    }

    /* Player: segunda linha do grid no tablet/desktop */
    .sets-section__player {
      grid-column: 5 / -1;
      grid-row: 2;
      margin-top: var(--section-spacing);
    }

    /* Catálogo: terceira linha do grid no tablet/desktop */
    .sets-section :global(.set-index) {
      grid-column: 5 / -1;
      grid-row: 3;
      margin-top: var(--space-6);
    }

    .maremoto-section {
      align-content: start;
    }

    .maremoto-section__player {
      grid-column: 5 / -1;
      grid-row: 2;

      margin-top: var(--section-spacing);
    }

    .maremoto-section :global(.maremoto-index) {
      grid-column: 5 / -1;
      grid-row: 3;

      margin-top: var(--space-6);
    }

    .date-invites {
      align-content: start;
    }

    .date-invites__player {
      grid-column: 5 / -1;
      grid-row: 2;

      margin-top: var(--section-spacing);
    }

    .date-invites :global(.date-invite-index) {
      grid-column: 5 / -1;
      grid-row: 3;

      margin-top: var(--space-6);
    }

    .editorial-section :global(.editorial-intro) {
      grid-column: 3 / -1;
      grid-row: 2;
      margin-top: var(--section-spacing);
    }

    .contact-section :global(.contact-details) {
      grid-column: 5 / -1;
      grid-row: 2;
      margin-top: var(--section-spacing);
    }
  }
</style>
